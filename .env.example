HF_TOKEN=your_huggingface_token_here

# LLM provider: huggingface or groq
LLM_PROVIDER=huggingface

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1
GROQ_REASONING_EFFORT=low
GROQ_MAX_TOKENS=1200
GROQ_MAX_RETRIES=2
GROQ_RETRY_DELAY_SECONDS=1.0

APP_ENV=development

# Production must use explicit origins.
# Example:
# chrome-extension://YOUR_EXTENSION_ID
CORS_ALLOW_ORIGINS=

# Local development accepts the local FastAPI host.
# Production must list the backend hostnames explicitly.
TRUSTED_HOSTS=127.0.0.1,localhost
MAX_REQUEST_BODY_BYTES=16384

HF_MODEL_ID=openai/gpt-oss-20b
HF_PROVIDER=auto
HF_TEMPERATURE=0.1

RAG_TOP_K=4
RAG_MAX_DISTANCE=1.30
RAG_MMR_FETCH_K=10
RAG_MMR_LAMBDA=0.7
# Reciprocal Rank Fusion combines semantic and lexical rankings by rank,
# avoiding incompatible score-scale comparisons.
RAG_RRF_K=60

# Add nearby transcript chunks around strong retrieval hits.
RAG_CONTEXT_EXPANSION_CHUNKS=1
RAG_CONTEXT_MAX_CHUNKS=12

# Evidence-dense questions use larger retrieval and context budgets.
RAG_DENSE_SEMANTIC_K=24
RAG_DENSE_SEMANTIC_FETCH_K=32
RAG_DENSE_ANCHOR_LIMIT=12
RAG_DENSE_ANCHOR_MIN_CHUNK_GAP=2
RAG_DENSE_CONTEXT_MAX_CHUNKS=16
# Leave context headroom for nearby evidence expansion.
RAG_DENSE_FACET_RERANK_WEIGHT=0.05

RATELIMIT_LIMIT=20/minute
RATELIMIT_STORAGE_URI=memory://

HF_MAX_TOKENS=1200
HF_REASONING_EFFORT=low
HF_MAX_RETRIES=2
HF_RETRY_DELAY_SECONDS=1.0

# Durable index job coordination
INDEX_JOB_DB_PATH=Backend/rag_system/index_jobs.sqlite3
INDEX_JOB_WORKERS=2
INDEX_JOB_LEASE_SECONDS=1800
