HF_TOKEN=your_huggingface_token_here

APP_ENV=development

# Production must use explicit origins.
# Example:
# chrome-extension://YOUR_EXTENSION_ID
CORS_ALLOW_ORIGINS=

HF_MODEL_ID=openai/gpt-oss-20b
HF_PROVIDER=auto
HF_TEMPERATURE=0.1

RAG_TOP_K=4
RAG_MAX_DISTANCE=1.30
RAG_MMR_FETCH_K=10
RAG_MMR_LAMBDA=0.7

RATELIMIT_LIMIT=20/minute
RATELIMIT_STORAGE_URI=memory://

HF_MAX_TOKENS=1200
HF_REASONING_EFFORT=low
HF_MAX_RETRIES=2
HF_RETRY_DELAY_SECONDS=1.0

# Durable index jobs
# Optional: defaults to Backend/rag_system/index_jobs.sqlite3
# INDEX_JOB_DB_PATH=
INDEX_JOB_POLL_SECONDS=0.5
INDEX_JOB_STALE_SECONDS=900
