HF_TOKEN=your_huggingface_token_here

APP_ENV=development

# Production must use explicit origins.
# Example:
# chrome-extension://YOUR_EXTENSION_ID
CORS_ALLOW_ORIGINS=

HF_MODEL_ID=openai/gpt-oss-20b
HF_PROVIDER=auto
HF_TEMPERATURE=0.1

RAG_TOP_K=4
RAG_MAX_DISTANCE=1.30
RAG_MMR_FETCH_K=10
RAG_MMR_LAMBDA=0.7