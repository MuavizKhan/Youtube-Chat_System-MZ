{
  "manifest_version": 3,
  "name": "YouTube AI Chat",
  "version": "1.1.0",
  "description": "Chat with YouTube videos using a local RAG-powered AI backend.",
  "action": {
    "default_title": "Toggle YouTube AI Chat"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ]
    }
  ]
}