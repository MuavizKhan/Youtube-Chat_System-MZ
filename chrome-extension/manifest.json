{
  "manifest_version": 3,

  "name": "YouTube AI Chat",

  "version": "1.0.0",

  "description": "Chat with YouTube videos using AI.",

  "action": {
    "default_popup": "popup.html"
  },

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}