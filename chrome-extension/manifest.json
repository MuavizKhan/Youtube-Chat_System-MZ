{
  "manifest_version": 3,
  "name": "YouTube AI Chat",
  "version": "1.0.0",
  "description": "Chat with YouTube videos using AI.",

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}